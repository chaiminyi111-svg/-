# 服务监听
PORT=3000
HOST=0.0.0.0

# 数据目录（SQLite 数据库会放在这里）
DATA_DIR=./data

# 首次启动时创建的管理员。已有用户后不会覆盖密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=管理员

# Telegram Bot Token，从 @BotFather 获取
# 也可以留空，登录管理员账号后在网页顶栏「渠道」中填写；网页配置优先
TELEGRAM_BOT_TOKEN=

# Telegram API 地址。默认官方地址；无法直连时可改成自建 Bot API 或反向代理
TELEGRAM_API_BASE=https://api.telegram.org

# 长轮询等待秒数
TELEGRAM_POLL_TIMEOUT=25

# 如果之前给机器人设置过 webhook，可设为 true 让服务启动时删除
TELEGRAM_DELETE_WEBHOOK=false

# 登录会话天数
SESSION_DAYS=7

# 部署在 Nginx/Caddy 等反向代理后面时保持 true
TRUST_PROXY=true

# auto / true / false。HTTPS 部署建议 true
COOKIE_SECURE=auto

# 可选：固定前端访问地址，例如 https://support.example.com
PUBLIC_ORIGIN=

# 单条回复最大长度，Telegram 上限 4096
MAX_MESSAGE_LENGTH=4096

LOG_LEVEL=info

# WhatsApp Cloud API（可选）。不填则只启用 Telegram。
# 也可以留空，登录管理员账号后在网页顶栏「渠道」中填写；网页配置优先
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta 后台配置 Webhook 时填写的自定义校验串
WHATSAPP_VERIFY_TOKEN=
# Meta 应用密钥，用于校验 X-Hub-Signature-256；生产环境必须配置
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE=https://graph.facebook.com/v20.0

# WhatsApp 个人号（WhatsApp Web / Baileys，实验渠道，默认关闭）
# 启用后由管理员在网页「渠道」中扫码登录；session 保存在 DATA_DIR 下，等同登录凭证
WHATSAPP_WEB_ENABLED=false
WHATSAPP_WEB_SESSION_PATH=

# 个人号模式（A 模式，默认开启）。每个员工绑定自己的 WhatsApp / Telegram 个人号，
# 与共用收件箱（B 模式）并存，可在网页顶栏自由切换。
PERSONAL_ACCOUNTS_ENABLED=true
# 个人号 session 根目录；每个账号会自动使用独立子目录
ACCOUNTS_DIR=

# Telegram 个人号（MTProto 扫码登录，默认关闭）
# 在 https://my.telegram.org 创建应用后填写 api_id / api_hash
TELEGRAM_USER_ENABLED=false
TELEGRAM_USER_API_ID=
TELEGRAM_USER_API_HASH=
# 仅兼容旧的单账号 CLI 登录；网页多账号模式使用 ACCOUNTS_DIR
TELEGRAM_USER_SESSION_PATH=

# Google Cloud Translation API Key（可选）。留空可在网页「渠道」中配置。
# 需要先在 Google Cloud 启用 Cloud Translation API。
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_API_BASE=https://translation.googleapis.com
# google（官方 API，需要 Key）
# google-web / google-web-main / google-chrome / mymemory（无需 Key，可能限流/失效）
TRANSLATE_PROVIDER=google
GOOGLE_TRANSLATE_WEB_API_BASE=https://translate.googleapis.com
GOOGLE_TRANSLATE_WEB_MAIN_API_BASE=https://translate.google.com
GOOGLE_TRANSLATE_CHROME_API_BASE=https://clients5.google.com
MYMEMORY_API_BASE=https://api.mymemory.translated.net
# 收到外文消息时翻译成的目标语言
TRANSLATE_TARGET=zh-CN
TRANSLATE_TIMEOUT_MS=10000

# 自动分配新会话：AUTO_ASSIGN=true 时生效，也可在网页「团队」中开启
AUTO_ASSIGN=false
# least_active（当前接待最少）或 round_robin（轮询）
AUTO_ASSIGN_STRATEGY=least_active
# 每个客服最多同时接待多少个未关闭会话，0 表示不限制
AGENT_MAX_ACTIVE=0

# 首次响应 SLA（分钟），用于统计超时数量
SLA_FIRST_RESPONSE_MINUTES=15

# 数据库备份目录与保留天数（npm run backup）
BACKUP_DIR=
BACKUP_KEEP_DAYS=14

# AI 自动回复（可选）。也可登录管理员账号后在网页「渠道」中配置；网页配置优先。
AI_ENABLED=false
# OpenAI 兼容接口。支持 OpenAI、DeepSeek、通义千问、智谱等。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# suggest / auto / first / after_hours / off
AI_DEFAULT_MODE=auto
AI_WORK_START=09:00
AI_WORK_END=18:00
AI_WORK_TIMEZONE=Asia/Shanghai
AI_INCLUDE_GROUPS=false
# 收到消息后等待多久再生成，合并连续消息
AI_DELAY_MS=1500
AI_TIMEOUT_MS=30000
# Pollinations 免费接口约 45 秒只能请求 1 次；本地 Ollama 不需要限流
AI_PUBLIC_MIN_INTERVAL_MS=45000
AI_MAX_CONTEXT=12
