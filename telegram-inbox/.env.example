# 服务监听
PORT=3000
HOST=0.0.0.0

# 数据目录（SQLite 数据库会放在这里）
DATA_DIR=./data

# 首次启动时创建的管理员。已有用户后不会覆盖密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=管理员

# Telegram Bot Token，从 @BotFather 获取
# 也可以留空，登录管理员账号后在网页顶栏「渠道」中填写；网页配置优先
TELEGRAM_BOT_TOKEN=

# Telegram API 地址。默认官方地址；无法直连时可改成自建 Bot API 或反向代理
TELEGRAM_API_BASE=https://api.telegram.org

# 长轮询等待秒数
TELEGRAM_POLL_TIMEOUT=25

# 如果之前给机器人设置过 webhook，可设为 true 让服务启动时删除
TELEGRAM_DELETE_WEBHOOK=false

# 登录会话天数
SESSION_DAYS=7

# 部署在 Nginx/Caddy 等反向代理后面时保持 true
TRUST_PROXY=true

# auto / true / false。HTTPS 部署建议 true
COOKIE_SECURE=auto

# 可选：固定前端访问地址，例如 https://support.example.com
PUBLIC_ORIGIN=

# 单条回复最大长度，Telegram 上限 4096
MAX_MESSAGE_LENGTH=4096

LOG_LEVEL=info

# WhatsApp Cloud API（可选）。不填则只启用 Telegram。
# 也可以留空，登录管理员账号后在网页顶栏「渠道」中填写；网页配置优先
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta 后台配置 Webhook 时填写的自定义校验串
WHATSAPP_VERIFY_TOKEN=
# Meta 应用密钥，用于校验 X-Hub-Signature-256；生产环境必须配置
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE=https://graph.facebook.com/v20.0

# Google Cloud Translation API Key（可选）。留空可在网页「渠道」中配置。
# 需要先在 Google Cloud 启用 Cloud Translation API。
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_API_BASE=https://translation.googleapis.com
# 收到外文消息时翻译成的目标语言
TRANSLATE_TARGET=zh-CN
TRANSLATE_TIMEOUT_MS=10000

# 自动分配新会话：AUTO_ASSIGN=true 时生效，也可在网页「团队」中开启
AUTO_ASSIGN=false
# least_active（当前接待最少）或 round_robin（轮询）
AUTO_ASSIGN_STRATEGY=least_active
# 每个客服最多同时接待多少个未关闭会话，0 表示不限制
AGENT_MAX_ACTIVE=0

# 首次响应 SLA（分钟），用于统计超时数量
SLA_FIRST_RESPONSE_MINUTES=15

# 数据库备份目录与保留天数（npm run backup）
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
